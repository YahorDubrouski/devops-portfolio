{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Working set divided by the container memory limit. Containers with no limit are left out. 100% means the container is at its cap.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic-by-name" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.8 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "checkout" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F2CC0C" } }]
          },
          {
            "matcher": { "id": "byName", "options": "promtail" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }]
          },
          {
            "matcher": { "id": "byName", "options": "cadvisor" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }]
          },
          {
            "matcher": { "id": "byName", "options": "node-exporter" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }]
          },
          {
            "matcher": { "id": "byName", "options": "grafana" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }]
          },
          {
            "matcher": { "id": "byName", "options": "loki" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#37D3C2" } }]
          }
        ]
      },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (service) (container_memory_working_set_bytes{service!=\"\"} / (container_spec_memory_limit_bytes{service!=\"\"} > 0))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "How full each service is",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["containers"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Memory headroom",
  "uid": "memory-headroom",
  "version": 1
}
