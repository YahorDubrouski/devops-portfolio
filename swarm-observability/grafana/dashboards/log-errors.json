{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Error lines per service over the last minute. The service name is the same one as on the memory chart.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "spanNulls": false }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (service) (count_over_time({job=\"containerlogs\", service=~\".+\"} |~ \"(?i)(level=error|error:|exception|fatal)\" != \"disabling udev\" != \"caller=metrics.go\" != \"caller=engine.go\" != \"caller=roundtrip.go\" != \"logger=tsdb.loki\" [1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Errors by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"containerlogs\", service=~\".+\"} |~ \"(?i)(level=error|error:|exception|fatal)\" != \"disabling udev\" != \"caller=metrics.go\" != \"caller=engine.go\" != \"caller=roundtrip.go\" != \"logger=tsdb.loki\" | line_format \"{{.service}}: {{__line__}}\"",
          "refId": "A"
        }
      ],
      "title": "What failed",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["logs"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Log errors",
  "uid": "log-errors",
  "version": 1
}
